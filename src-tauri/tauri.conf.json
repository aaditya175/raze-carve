{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "RAZE-CARVE",
  "version": "0.1.0",
  "identifier": "dev.razecarve.app",
  "build": {
    "frontendDist": "../src-ui/dist",
    "beforeDevCommand": "cd ../src-ui && npm run dev",
    "beforeBuildCommand": "cd ../src-ui && npm run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http://localhost:7878 http://127.0.0.1:7878 ws://localhost:7878 ws://127.0.0.1:7878;"
    },
    "windows": [
      {
        "label": "main",
        "title": "RAZE-CARVE — Sanitize. Recover. Certify.",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
